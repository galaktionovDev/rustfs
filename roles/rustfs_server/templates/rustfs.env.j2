{% set api_port = (rustfs_api_port | default(9000)) | int %}
{% set bind_address = (rustfs_bind_address | default('')) %}

RUSTFS_ACCESS_KEY={{ rustfs_root_user | default('rustfsadmin') }}
RUSTFS_SECRET_KEY={{ rustfs_root_password | default('rustfsadmin') }}

{# ============================================================ #}
{# ДИНАМИЧЕСКИЙ РАСЧЕТ ТОПОЛОГИИ (STANDALONE VS DISTRIBUTED)    #}
{# ============================================================ #}

{% set cluster_mode = rustfs_cluster_mode | default('Single Instance') %}
{% set nodes_group = rustfs_cluster_nodes_group | default('rustfs_nodes') %}
{% set disks_raw = rustfs_server_datadirs | default(['/app/rustfs1']) %}

{# Определяем количество хостов в инвентаре #}
{% if nodes_group in groups and (groups[nodes_group] | length) > 0 %}
  {% set cluster_hosts = (groups[nodes_group] | sort) %}
{% else %}
  {% set cluster_hosts = (ansible_play_hosts_all | sort) %}
{% endif %}
{% set cluster_size = (cluster_hosts | length) | int %}
{% set disk_count = (disks_raw | length) | int %}

{# Логика генерации путей RUSTFS_VOLUMES #}
{% if cluster_size == 1 %}
  {% if disk_count == 1 %}
RUSTFS_VOLUMES="{{ disks_raw[0] }}"
  {% else %}
RUSTFS_VOLUMES="/app/disk{1...{{ disk_count }}}"
  {% endif %}
{% else %}
  {% set node_pattern = "http://node-{1..." ~ cluster_size ~ "}:" ~ api_port %}
  {% if disk_count > 1 %}
    {% set disk_pattern = "/app/disk{1..." ~ disk_count ~ "}" %}
  {% else %}
    {% set disk_pattern = disks_raw[0] %}
  {% endif %}
RUSTFS_VOLUMES="{{ node_pattern }}{{ disk_pattern }}"
{% endif %}

{# ============================================================ #}

RUSTFS_ADDRESS="{{ bind_address }}:{{ api_port }}"

RUSTFS_CONSOLE_ENABLE={{ rustfs_console_enable | default(true) | lower }}
RUST_LOG={{ rustfs_log_level | default('error') }}
RUSTFS_OBS_LOG_DIRECTORY="{{ rustfs_log_dir | default('/var/log/rustfs') }}/"

{# Отключение проверки физических дисков для тест/dev сред #}
{% if rustfs_unsafe_bypass_disk_check | default(false) | bool %}
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true
{% endif %}